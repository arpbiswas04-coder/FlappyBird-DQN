# Server Port (defaults to 8000 locally; Render automatically sets this in production)
PORT=8000

# Optional: Direct HTTPS URL to download the pre-trained DQN checkpoint (.zip archive or .pt)
# Required on cloud deployments (like Render) where runs/ is gitignored.
# Example: GitHub Releases Asset, AWS S3, Google Cloud Storage, or Hugging Face.
MODEL_URL=https://github.com/arpbiswas04-coder/FlappyBird-DQN/releases/download/v1.0.0/flappybird-model.zip
